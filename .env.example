# --- AI (optional): second opinion + reading screenshots ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Link reputation (optional) ---
GOOGLE_SAFE_BROWSING_KEY=
CHECK_DOMAIN_AGE=1

# --- WhatsApp Business Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
WHATSAPP_API_VERSION=v23.0

# --- Email (Postmark) ---
POSTMARK_SERVER_TOKEN=
REPLY_FROM_EMAIL=verifier@your-domain.fr
INBOUND_EMAIL_TOKEN=choose-another-long-random-string

# --- Misc ---
DAILY_LIMIT_PER_USER=30
LOG_LEVEL=INFO
